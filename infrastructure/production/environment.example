# Public non-secret configuration. Keep real files outside the checkout.
STUDIO_HOST=studio.example.org
API_HOST=api.example.org
IDENTITY_HOST=identity.example.org
KEYCLOAK_REALM=foundry
# Replace with approved registry@sha256:... values, never mutable production tags.
API_IMAGE=registry.example.org/foundry-api@sha256:REPLACE
STUDIO_IMAGE=registry.example.org/foundry-studio@sha256:REPLACE
POSTGRES_IMAGE=registry.example.org/foundry-postgres@sha256:REPLACE
SEMANTIC_IMAGE=registry.example.org/foundry-semantic@sha256:REPLACE
SECRETS_DIRECTORY=/srv/foundry/secrets
TLS_DIRECTORY=/srv/foundry/tls
WAL_ARCHIVE_DIRECTORY=/srv/foundry/encrypted-wal
KEYCLOAK_IMPORT_DIRECTORY=/srv/foundry/realm-import
WORKER_TENANT_ID=00000000-0000-0000-0000-000000000001
WORKER_ONTOLOGY=manufacturing
WORKER_CATALOG_FILE=/srv/foundry/secrets/FOUNDRY_INGESTION_CATALOG_JSON
INGESTION_DIRECTORY=/srv/foundry/inputs

# Built from infrastructure/docker/ingress.Dockerfile; do not use the unpatched base.
INGRESS_IMAGE=registry.example.org/foundry-ingress@sha256:REPLACE_WITH_APPROVED_DIGEST

# Set true when FOUNDRY_DATABASE_URL names the same existing owner for migrations and runtime.
# Owner mode needs no second application database role and no runtime table-grant refresh.
# This exception covers ownership only; elevated PostgreSQL role flags remain rejected.
FOUNDRY_ALLOW_OWNER_RUNTIME_ROLE=false
