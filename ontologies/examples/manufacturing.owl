    <!-- https://example.org/ontologies/manufacturing#CriticalMachine -->

    <owl:Class rdf:about="https://example.org/ontologies/manufacturing#CriticalMachine">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/ontologies/manufacturing#Machine"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/ontologies/manufacturing#operationalStatus"/>
                        <owl:hasValue>CRITICAL</owl:hasValue>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:label xml:lang="en">Critical machine</rdfs:label>
    </owl:Class>
    


