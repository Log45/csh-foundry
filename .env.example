# Copy to .env; choose a local password. Never commit .env.
POSTGRES_USER=foundry
POSTGRES_DB=foundry
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
FOUNDRY_DATABASE_URL=postgresql+psycopg://foundry:REPLACE_ME@localhost:55432/foundry
FOUNDRY_TRUSTED_LOCAL_IDENTITY=false
# Enable only on a trusted loopback development server, with both IDs set.
# FOUNDRY_LOCAL_TENANT_ID=
# FOUNDRY_LOCAL_PRINCIPAL_ID=

# After choosing these explicitly, provision with:
# uv run python -m ontology_platform.bootstrap --name "Local manufacturing"
# Local mode uses only the server-configured tenant; production verifies membership for X-Tenant-ID.

# Optional random >=32-byte cursor signing secret; omitted = process-local random key.
# FOUNDRY_QUERY_CURSOR_SECRET=

# Optional server-managed tenant source registrations; never expose connection credentials to clients.
# FOUNDRY_INGESTION_CATALOG_JSON='[]'

# Explicit production authentication. Disabled mode denies all operational requests.
FOUNDRY_AUTH_MODE=disabled
# RFC 9068 API access tokens only; provider clients must emit typ=at+jwt and client_id.
# FOUNDRY_AUTH_MODE=oidc
# FOUNDRY_OIDC_PROVIDERS='[{"id":"corporate","issuer":"https://identity.example/realm","audience":"foundry-api","clients":["studio","worker"]}]'
# Use auth_mode=local plus TRUSTED_LOCAL_IDENTITY=true only in isolated development.
# Standalone workers use short-lived service access tokens and explicit tenant/delegation.
# FOUNDRY_WORKER_ACCESS_TOKEN=
# FOUNDRY_WORKER_TENANT_ID=
# FOUNDRY_WORKER_SUBJECT_ID=

# Phase 8 browser BFF. Configure a trusted PKCE OIDC client and the same API audience as Phase 7.
# Issuer endpoints must share its HTTPS origin; do not use live Microsoft/Google tokens directly.
STUDIO_ORIGIN=http://127.0.0.1:3000
STUDIO_OIDC_ISSUER=
STUDIO_OIDC_CLIENT_ID=studio
STUDIO_API_AUDIENCE=foundry-api
# Host development only (Compose sets this to http://api:8000 on its private network):
STUDIO_API_ORIGIN=http://127.0.0.1:8000
# Optional PEM CA bundle for a local/private HTTPS issuer (API and workers).
# FOUNDRY_OIDC_CA_BUNDLE=/absolute/path/to/issuer-ca.pem
# Docker-only local CA directory and container paths; leave empty for public trusted issuers.
# FOUNDRY_OIDC_CA_DIRECTORY=/absolute/path/to/public-ca-directory
# FOUNDRY_DOCKER_OIDC_CA_BUNDLE=/etc/foundry/certs/ca.pem
# STUDIO_NODE_EXTRA_CA_CERTS=/etc/foundry/certs/ca.pem
