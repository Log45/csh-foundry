# Copy to .env; choose a local password. Never commit .env.
POSTGRES_USER=foundry
POSTGRES_DB=foundry
POSTGRES_PASSWORD=
POSTGRES_PORT=55432
FOUNDRY_DATABASE_URL=postgresql+psycopg://foundry:REPLACE_ME@localhost:55432/foundry
FOUNDRY_TRUSTED_LOCAL_IDENTITY=false
# Enable only on a trusted loopback development server, with both IDs set.
# FOUNDRY_LOCAL_TENANT_ID=
# FOUNDRY_LOCAL_PRINCIPAL_ID=

# After choosing these explicitly, provision with:
# uv run python -m ontology_platform.bootstrap --name "Local manufacturing"
# No tenant selection is accepted from HTTP headers.

# Optional random >=32-byte cursor signing secret; omitted = process-local random key.
# FOUNDRY_QUERY_CURSOR_SECRET=

# Optional server-managed tenant source registrations; never expose connection credentials to clients.
# FOUNDRY_INGESTION_CATALOG_JSON='[]'
